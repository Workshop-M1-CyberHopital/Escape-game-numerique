# ==============================================================================
# Backend Escape Game - Modèle d'environnement (.env.example)
# ==============================================================================
# Copiez ce fichier en '.env' dans le dossier back/ (non commité, prioritaire sur config.env).
# En conteneur, passez ces variables via l'environnement (docker-compose, Secret Kubernetes...).
# ==============================================================================

# Port d'écoute du serveur
PORT=3001

# Environnement (development | production)
NODE_ENV=development

# Secret de signature des JWT. OBLIGATOIRE en production : générez-le avec `openssl rand -hex 32`.
# S'il est absent (ou égal à une valeur publique du dépôt) en production, le serveur l'ignore,
# affiche un avertissement et utilise un secret aléatoire propre au processus (sessions perdues au redémarrage).
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# Origines autorisées en CORS (liste séparée par des virgules, "*" = toutes).
# Inutile si le front appelle /api sur la même origine (proxy nginx). FRONTEND_URL est aussi accepté.
# En développement, localhost et les adresses du réseau local sont toujours autorisés.
CORS_ORIGIN=
FRONTEND_URL=

# Valeur "trust proxy" d'Express : nombre de proxies devant Node (1 = nginx, 2 = Ingress + nginx),
# true/false, ou liste d'adresses/sous-réseaux. Défaut : 1 en production, false sinon.
TRUST_PROXY=

# Limitation de débit sur /api (par IP ; une classe entière peut partager une même IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# Nombre d'ÉCHECS de connexion / inscription tolérés par IP et par fenêtre
AUTH_RATE_LIMIT_MAX=50

# Dossier des fichiers JSON (users.json, scores.json). Chemin absolu ou relatif à back/.
# Un seul processus doit utiliser ce dossier (1 seul réplica).
DATA_DIR=./data
