# ==============================================================================
# Backend Escape Game - Modèle d'environnement (.env.example)
# ==============================================================================
# Copiez ce fichier en '.env' dans le dossier back/
# ==============================================================================

# Port d'écoute du serveur
PORT=3001

# Environnement (development | production)
NODE_ENV=development

# Origines Frontend autorisées pour CORS
FRONTEND_URL=http://localhost:5173

# Sécurité JWT & Chiffrement
JWT_SECRET=escape-game-super-secret-key-change-in-production
BCRYPT_ROUNDS=12

# Sessions & Rate Limiting (Optionnel)
SESSION_SECRET=session-super-secret-key
SESSION_MAX_AGE=86400000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
