# Valeurs par défaut pour le DÉVELOPPEMENT LOCAL uniquement.
# Ce fichier n'est jamais chargé quand NODE_ENV=production.
# Pour des valeurs personnelles, créez back/.env (non commité, prioritaire) à partir de .env.example.

PORT=3001
NODE_ENV=development

# Secret JWT : laissé vide en développement (un secret de dev intégré est utilisé).
# En production, JWT_SECRET doit être défini dans l'environnement (openssl rand -hex 32).
JWT_SECRET=

JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# En développement, toutes les origines localhost / réseau local sont déjà autorisées.
# CORS_ORIGIN=http://localhost:5173
