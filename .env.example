# ==============================================================================
# Variables d'environnement - modèle (.env.example)
# ==============================================================================
# Copiez ce fichier en '.env' (à la racine du dépôt) et complétez-le avec vos propres valeurs.
#   - Docker Compose lit automatiquement ce .env (docker-compose.yml) ;
#   - les scripts infra/cluster-*/deploy-infra*.sh le chargent pour créer les Secrets Kubernetes
#     (ils lisent d'abord un .env placé dans leur propre dossier, sinon celui de la racine).
# NE COMMITEZ JAMAIS LE FICHIER '.env' (il est dans .gitignore).
#
# Format : une variable par ligne, NOM=valeur, sans espace ni guillemet ni commentaire en fin de
# ligne (les scripts de déploiement le chargent avec `export $(grep -v '^#' .env | xargs)`).
#
# Pour le développement local sans Docker, l'API lit back/.env (modèle : back/.env.example)
# puis back/config.env (valeurs de développement), et le frontend lit front/.env (VITE_*).
# ==============================================================================


# ------------------------------------------------------------------------------
# API Node.js (passées au conteneur par docker-compose.yml)
# ------------------------------------------------------------------------------

# Secret de signature des tokens JWT. OBLIGATOIRE : générez-le avec `openssl rand -hex 32`.
# docker compose refuse de démarrer s'il est vide. En production, une valeur absente ou égale à
# une valeur publique du dépôt est ignorée par l'API (avertissement + secret aléatoire par
# processus : toutes les sessions sont perdues à chaque redémarrage).
# Les scripts de déploiement Kubernetes le copient dans le Secret 'escape-jwt-secret'
# (s'il est vide, un secret aléatoire est généré une seule fois dans le cluster).
JWT_SECRET=

# Durée de validité d'un token ("24h", "7d" ou un nombre de secondes). Défaut : 24h
JWT_EXPIRES_IN=24h

# Coût bcrypt du hachage des mots de passe. Défaut : 10 (12+ devient lent sur un petit CPU)
BCRYPT_ROUNDS=10

# Origines autorisées en CORS, séparées par des virgules ("*" = toutes). FRONTEND_URL est aussi
# accepté (les deux listes sont cumulées). Inutile quand le frontend appelle /api sur la même
# origine (proxy Nginx du conteneur). En développement (NODE_ENV=development), localhost et les
# adresses du réseau local sont toujours acceptés.
# Exemple : CORS_ORIGIN=https://escape.eisi-dune.eu,http://localhost:5173
CORS_ORIGIN=http://localhost

# Valeur "trust proxy" d'Express = nombre de reverse proxies devant Node.js, pour que req.ip
# (rate limiting, logs) soit l'IP réelle du joueur :
#   1 = Nginx seul (docker compose, docker run)     2 = Ingress/Traefik + Nginx (Kubernetes)
# Accepte aussi true/false ou une liste d'adresses/sous-réseaux. Défaut : 1 en production, false sinon.
TRUST_PROXY=1

# Limitation de débit sur /api, par IP et par fenêtre (une classe entière peut partager une IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# Nombre d'ÉCHECS de connexion / inscription tolérés par IP et par fenêtre
AUTH_RATE_LIMIT_MAX=50

# Variables fixées par l'image Docker (à définir seulement pour lancer l'API hors conteneur) :
#   PORT=3001                  port d'écoute de l'API
#   NODE_ENV=production        "development" en local
#   DATA_DIR=/app/back/data    dossier des fichiers JSON users.json / scores.json (défaut : back/data)
# L'API stocke tout dans ces fichiers JSON avec UN SEUL processus : ne lancez jamais plusieurs
# conteneurs / réplicas sur le même jeu de données (cf. infra/cluster-*/escape.yaml).


# ------------------------------------------------------------------------------
# Docker Compose (optionnel)
# ------------------------------------------------------------------------------

# Image utilisée / construite par docker compose (même dépôt que push-to-hub.sh)
IMAGE_REPO=produn/escape-workshop
IMAGE_TAG=latest
# Port de l'application sur la machine hôte (http://localhost:HTTP_PORT)
HTTP_PORT=80
# Port de debug de l'API, lié à 127.0.0.1 uniquement
API_DEBUG_PORT=3001


# ------------------------------------------------------------------------------
# Déploiement Kubernetes (infra/cluster-*/deploy-infra*.sh)
# ------------------------------------------------------------------------------

# Gandi API Token (Personal Access Token PAT), obtenu sur https://admin.gandi.net/user/tokens
GANDI_API_TOKEN=your_gandi_pat_token_here

# Redis
REDIS_PASSWORD=change_this_redis_password

# MariaDB / MySQL
MARIADB_ROOT_PASSWORD=change_this_mariadb_root_password
MARIADB_USER=escape
MARIADB_PASSWORD=change_this_escape_password
MARIADB_DATABASE=escape_db


# ------------------------------------------------------------------------------
# Frontend (variables de BUILD Vite, intégrées au JavaScript public : jamais de secret ici)
# ------------------------------------------------------------------------------
# Image Docker : transmises comme build args par `docker compose build` (depuis ce .env) et par
# push-to-hub.sh (depuis l'environnement). Développement local : mettez-les dans front/.env.
# Laissez vide pour garder le comportement par défaut.

# "false" masque les DevTools du jeu (ils sont affichés si la variable n'est pas définie)
VITE_DEV_MODE=
# URL de l'API. Par défaut : http://<hôte>:3001/api en développement, /api (même origine) en production
VITE_API_URL=
