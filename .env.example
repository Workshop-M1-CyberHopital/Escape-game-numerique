# ==============================================================================
# Variables d'environnement - Modèle d'exemple (.env.example)
# ==============================================================================
# Copiez ce fichier en '.env' et complétez avec vos propres valeurs confidentielles.
# NE COMMITEZ JAMAIS LE FICHIER '.env' DANS LE RÉPERTOIRE GIT.
# ==============================================================================

# Gandi API Token (Personal Access Token PAT)
# Obtenu sur https://admin.gandi.net/user/tokens
GANDI_API_TOKEN=your_gandi_pat_token_here

# Redis
REDIS_PASSWORD=change_this_redis_password

# MariaDB / MySQL
MARIADB_ROOT_PASSWORD=change_this_mariadb_root_password
MARIADB_USER=escape
MARIADB_PASSWORD=change_this_escape_password
MARIADB_DATABASE=escape_db

# Backend Node.js
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=escape-game-super-secret-key-change-in-production
BCRYPT_ROUNDS=12
